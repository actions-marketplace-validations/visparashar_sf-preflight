<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Contract_Signed_Date</fullName>
    <active>true</active>
    <description>Finance: closed-won deals need a signed contract date.</description>
    <errorConditionFormula>AND(
    ISPICKVAL(StageName, &quot;Closed Won&quot;),
    ISBLANK(Contract_Signed_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Contract_Signed_Date__c</errorDisplayField>
    <errorMessage>Enter the contract signed date before closing the deal.</errorMessage>
</ValidationRule>
